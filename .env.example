# Environment Variables untuk Teknik Kimia PolSRI
# Copy file ini jadi .env.local dan isi dengan credential Supabase baru

# Supabase URL - dapatkan dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Supabase Anon Key - dapatkan dari Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxx

# Supabase Service Role Key - dapatkan dari Project Settings > API (RAHASIA, jangan commit!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxx

# Note: 
# - Jangan commit file .env.local ke GitHub
# - Service Role Key hanya untuk server-side, jangan di client
# - Untuk production (Vercel), masukkan semua 3 variable ini di Settings > Environment Variables
